async function saveStockAdjustment(
  form
) {

  if (!requireStore()) {
    return;
  }


  const id =
    form.dataset.id;


  const medicine =
    state.medicines.find(
      item =>
        item.id === id
    );


  if (!medicine) {
    return;
  }


  const fd =
    new FormData(form);


  const type =
    fd.get("type");


  const amount =
    Math.max(
      0,
      num(fd.get("quantity"))
    );


  const reason =
    String(
      fd.get("reason") || ""
    ).trim();


  let newQuantity;


  if (type === "add") {

    newQuantity =
      num(medicine.quantity) +
      amount;

  } else if (
    type === "subtract"
  ) {

    newQuantity =
      Math.max(
        0,
        num(medicine.quantity) -
        amount
      );

  } else {

    newQuantity =
      amount;

  }


  try {

    await updateDoc(
      doc(
        db,
        "medicines",
        id
      ),
      {

        quantity:
          newQuantity,

        updatedAt:
          serverTimestamp()

      }
    );


    await audit(
      "stock_adjustment",
      "medicines",
      {

        medicineId: id,

        oldQuantity:
          num(medicine.quantity),

        newQuantity,

        type,

        amount,

        reason

      }
    );


    closeModal();

    await loadAll();

    navigate("inventory");


    toast(
      "تم تعديل المخزون",
      "success"
    );

  } catch (error) {

    console.error(error);

    toast(
      "تعذر تعديل المخزون",
      "error"
    );

  }
}


