async function saveCustomerPayment(
  form
) {

  if (!requireCashier()) {
    return;
  }


  const id =
    form.dataset.id;


  const customer =
    state.customers.find(
      item =>
        item.id === id
    );


  if (!customer) {
    return;
  }


  const fd =
    new FormData(form);


  const amount =
    Math.max(
      0,
      num(fd.get("amount"))
    );


  if (
    amount <= 0 ||
    amount >
    num(customer.balance)
  ) {

    toast(
      "مبلغ التحصيل غير صحيح",
      "warning"
    );

    return;
  }


  const description =
    String(
      fd.get("description") || ""
    ).trim();


  try {

    await runTransaction(
      db,
      async transaction => {

        const customerRef =
          doc(
            db,
            "customers",
            id
          );


        const customerSnap =
          await transaction.get(
            customerRef
          );


        if (!customerSnap.exists()) {
          throw new Error(
            "العميل غير موجود"
          );
        }


        const current =
          customerSnap.data();


        const balance =
          Math.max(
            0,
            num(current.balance) -
            amount
          );


        transaction.update(
          customerRef,
          {

            balance,

            updatedAt:
              serverTimestamp()

          }
        );


        const paymentRef =
          doc(
            collection(
              db,
              "customerPayments"
            )
          );


        transaction.set(
          paymentRef,
          {

            customerId: id,

            customerName:
              current.name || "",

            amount,

            description,

            createdAt:
              serverTimestamp(),

            userId:
              state.user.uid

          }
        );


        const treasuryRef =
          doc(
            collection(
              db,
              "treasury"
            )
          );


        transaction.set(
          treasuryRef,
          {

            type: "income",

            category:
              "customer_payment",

            description,

            amount,

            referenceId:
              paymentRef.id,

            createdAt:
              serverTimestamp(),

            userId:
              state.user.uid

          }
        );

      }
    );


    await audit(
      "customer_payment",
      "customers",
      {
        customerId: id,
        amount
      }
    );


    closeModal();

    await loadAll();

    navigate("customers");


    toast(
      "تم تسجيل التحصيل",
      "success"
    );

  } catch (error) {

    console.error(error);

    toast(
      "تعذر تسجيل التحصيل",
      "error"
    );

  }
}


