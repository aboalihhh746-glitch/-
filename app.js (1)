/* =========================================================
   النسخ الاحتياطي
   ========================================================= */

function serializeValue(
  value
) {

  if (
    value &&
    typeof value.toDate ===
    "function"
  ) {

    return value
      .toDate()
      .toISOString();

  }


  if (
    value instanceof Date
  ) {

    return value.toISOString();

  }


  if (
    Array.isArray(value)
  ) {

    return value.map(
      serializeValue
    );

  }


  if (
    value &&
    typeof value === "object"
  ) {

    const result = {};

    Object.entries(value)
      .forEach(
        ([key, val]) => {

          result[key] =
            serializeValue(val);

        }
      );

    return result;

  }


  return value;
}


async function backupData() {

  if (!requireAdmin()) {
    return;
  }


  loading(
    true,
    "جاري إنشاء النسخة الاحتياطية..."
  );


  try {

    const collections = [

      "medicines",

      "customers",

      "suppliers",

      "purchases",

      "sales",

      "treasury",

      "settings",

      "users",

      "auditLogs",

      "customerPayments",

      "supplierPayments"

    ];


    const backup = {

      app:
        "صيدليتي Pro",

      version:
        "2.0",

      exportedAt:
        new Date().toISOString(),

      collections: {}

    };


    for (
      const name of collections
    ) {

      try {

        const snap =
          await getDocs(
            collection(
              db,
              name
            )
          );


        backup.collections[name] =
          snap.docs.map(
            item => ({

              id:
                item.id,

              data:
                serializeValue(
                  item.data()
                )

            })
          );

      } catch {

        backup.collections[name] =
          [];

      }

    }


    const blob =
      new Blob(
        [
          JSON.stringify(
            backup,
            null,
            2
          )
        ],
        {
          type:
            "application/json"
        }
      );


    const url =
      URL.createObjectURL(
        blob
      );


    const a =
      document.createElement(
        "a"
      );


    a.href =
      url;

    a.download =
      `pharmacy-backup-${localToday()}.json`;


    document.body.appendChild(a);

    a.click();

    a.remove();


    URL.revokeObjectURL(url);


    await audit(
      "backup",
      "system"
    );


    toast(
      "تم إنشاء النسخة الاحتياطية",
      "success"
    );

  } catch (error) {

    console.error(error);

    toast(
      "تعذر إنشاء النسخة الاحتياطية",
      "error"
    );

  } finally {

    loading(false);

  }
}


/* =========================================================
   استعادة النسخة الاحتياطية
   ========================================================= */

async function restoreBackup(
  file
) {

  if (!requireAdmin()) {
    return;
  }


  if (!file) {
    return;
  }


  const confirmed =
    confirm(
      "تحذير: استعادة النسخة قد تضيف أو تستبدل بيانات موجودة. هل تريد المتابعة؟"
    );


  if (!confirmed) {
    return;
  }


  loading(
    true,
    "جاري استعادة النسخة الاحتياطية..."
  );


  try {

    const text =
      await file.text();


    const backup =
      JSON.parse(text);


    if (
      !backup ||
      !backup.collections
    ) {

      throw new Error(
        "ملف النسخة الاحتياطية غير صحيح"
      );

    }


    const allowed = [

      "medicines",

      "customers",

      "suppliers",

      "purchases",

      "sales",

      "treasury",

      "settings",

      "customerPayments",

      "supplierPayments"

    ];


    for (
      const collectionName
      of allowed
    ) {

      const records =
        backup.collections[
          collectionName
        ] || [];


      for (
        let i = 0;
        i < records.length;
        i += 400
      ) {

        const batch =
          writeBatch(db);


        const chunk =
          records.slice(
            i,
            i + 400
          );


        chunk.forEach(
          record => {

            if (
              !record.id ||
              !record.data
            ) {
              return;
            }


            batch.set(
              doc(
                db,
                collectionName,
                record.id
              ),
              record.data,
              {
                merge: true
              }
            );

          }
        );


        await batch.commit();

      }

    }


    await audit(
      "restore_backup",
      "system"
    );


    await loadAll();


    toast(
      "تمت استعادة النسخة الاحتياطية",
      "success"
    );

  } catch (error) {

    console.error(error);

    toast(
      "تعذر استعادة النسخة الاحتياطية",
      "error"
    );

  } finally {

    loading(false);

  }
}


