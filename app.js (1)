   ========================================================= */

function exportCSV() {

  const sales =
    getReportSales();


  const rows = [

    [
      "رقم الفاتورة",
      "التاريخ",
      "الإجمالي",
      "التكلفة",
      "الربح",
      "طريقة الدفع"
    ],

    ...sales.map(
      sale => [

        sale.invoiceNo || "",

        sale.saleDate || "",

        num(sale.total),

        num(sale.cogs),

        num(sale.profit),

        sale.paymentMethod === "credit"
          ? "آجل"
          : "نقدي"

      ]
    )

  ];


  const csv =
    "\uFEFF" +
    rows
      .map(
        row =>
          row
            .map(
              value =>
                `"${String(value)
                  .replaceAll('"', '""')}"`
            )
            .join(",")
      )
      .join("\n");


  const blob =
    new Blob(
      [csv],
      {
        type:
          "text/csv;charset=utf-8;"
      }
    );


  const url =
    URL.createObjectURL(blob);


  const a =
    document.createElement("a");


  a.href =
    url;

  a.download =
    `sales-${localToday()}.csv`;


  document.body.appendChild(a);

  a.click();

  a.remove();


  URL.revokeObjectURL(url);
}


