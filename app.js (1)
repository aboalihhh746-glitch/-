  if (navigator.onLine) {

    el.classList.remove("offline");

    if (text) {
      text.textContent =
        "متصل بالإنترنت";
    }

  } else {

    el.classList.add("offline");

    if (text) {
      text.textContent =
        "غير متصل";
    }

  }
}


