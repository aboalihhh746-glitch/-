document.addEventListener(
  "submit",
  event => {

    const form =
      event.target;


    if (
      form.id ===
      "medicineForm"
    ) {

      event.preventDefault();

      const id =
        form.dataset.id;


      const medicine =
        id
          ? state.medicines.find(
              item =>
                item.id === id
            )
          : null;


      saveMedicine(
        form,
        medicine
      );

      return;
    }


    if (
      form.id ===
      "stockForm"
    ) {

      event.preventDefault();

      saveStockAdjustment(
        form
      );

      return;
    }


    if (
      form.id ===
      "customerForm"
    ) {

      event.preventDefault();

      saveCustomer(
