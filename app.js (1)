onAuthStateChanged(
  auth,
  async user => {

    if (user) {

      state.user =
        user;


      $("loginScreen")
        ?.setAttribute(
          "hidden",
          ""
        );


      $("app")
        ?.removeAttribute(
          "hidden"
        );


      try {

        await loadUserProfile();

        await loadAll();

        navigate(
          "dashboard"
        );

      } catch (error) {

        console.error(error);

        toast(
          "تعذر تشغيل النظام",
          "error"
        );

      }

    } else {

      state.user =
        null;

      state.profile =
        null;

      state.role =
        "none";


      $("app")
        ?.setAttribute(
          "hidden",
          ""
        );


      $("loginScreen")
        ?.removeAttribute(
          "hidden"
        );


      if ($("loginPassword")) {
        $("loginPassword").value =
          "";
      }

    }

  }
);


