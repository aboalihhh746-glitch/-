async function savePurchase(
  form
) {

  if (!requireStore()) {
    return;
  }


  const supplierId =
    form.querySelector(
      '[name="supplierId"]'
    )?.value;


  const supplier =
    state.suppliers.find(
      item =>
        item.id === supplierId
    );


  if (!supplier) {

    toast(
      "اختر المورد",
      "warning"
    );

    return;
  }


  const lines =
    [
      ...form.querySelectorAll(
        ".line-item"
      )
    ];


  const items = [];


  for (
    const line of lines
  ) {

    const medicineId =
      line.querySelector(
        '[name="medicineId"]'
      )?.value || "";


    const quantity =
      Math.max(
        0,
        num(
          line.querySelector(
            '[name="quantity"]'
          )?.value
        )
      );


    const purchasePrice =
      Math.max(
        0,
        num(
          line.querySelector(
            '[name="purchasePrice"]'
          )?.value
        )
      );


    const salePrice =
      Math.max(
        0,
        num(
          line.querySelector(
            '[name="salePrice"]'
          )?.value
        )
      );


    if (
      quantity <= 0
    ) {
      continue;
    }


    const medicine =
      state.medicines.find(
        item =>
          item.id === medicineId
      );


    items.push({

      medicineId,

      medicineName:
        medicine?.tradeName || "",

      quantity,

      purchasePrice,

      salePrice

    });

  }


  if (!items.length) {

    toast(
      "أضف صنفًا واحدًا على الأقل",
      "warning"
    );

    return;
  }


  const total =
    items.reduce(
      (sum, item) =>
        sum +
        item.quantity *
        item.purchasePrice,
      0
    );


  const paid =
    Math.min(
      total,
      Math.max(
        0,
        num(
          form.querySelector(
            '[name="paid"]'
          )?.value
        )
      )
    );


  const balance =
    Math.max(
      0,
      total - paid
    );


  loading(
    true,
    "جاري حفظ فاتورة الشراء..."
  );


  try {

    await runTransaction(
      db,
      async transaction => {

        const supplierRef =
          doc(
            db,
            "suppliers",
            supplierId
          );


        const supplierSnap =
          await transaction.get(
            supplierRef
          );


        if (!supplierSnap.exists()) {

          throw new Error(
            "المورد غير موجود"
          );

        }


        const currentSupplier =
          supplierSnap.data();


        const purchaseRef =
          doc(
            collection(
              db,
              "purchases"
            )
          );


        const invoiceNo =
          `PUR-${Date.now()}`;


        for (
          const item of items
        ) {

          if (item.medicineId) {

            const medicineRef =
              doc(
                db,
                "medicines",
                item.medicineId
              );


            const medicineSnap =
              await transaction.get(
                medicineRef
              );


            if (!medicineSnap.exists()) {
              continue;
            }


            const medicine =
              medicineSnap.data();


            transaction.update(
              medicineRef,
              {

                quantity:
                  num(medicine.quantity) +
                  item.quantity,

                purchasePrice:
                  item.purchasePrice,

                salePrice:
                  item.salePrice,

                updatedAt:
                  serverTimestamp()

              }
            );

          }

        }


        transaction.update(
          supplierRef,
          {

            balance:
              num(currentSupplier.balance) +
              balance,

            updatedAt:
              serverTimestamp()

          }
        );


        transaction.set(
          purchaseRef,
          {

            invoiceNo,

            supplierId,

            supplierName:
              currentSupplier.name || "",

            items,

            total,

            paid,

            balance,

            createdAt:
              serverTimestamp(),

            userId:
              state.user.uid,

            userEmail:
              state.user.email || ""

          }
        );


        if (paid > 0) {

          const treasuryRef =
            doc(
              collection(
                db,
                "treasury"
              )
            );


          transaction.set(
            treasuryRef,
            {

              type: "expense",

              category:
                "purchase",

              description:
                `شراء - ${invoiceNo}`,

              amount:
                paid,

              referenceId:
                purchaseRef.id,

              createdAt:
                serverTimestamp(),

              userId:
                state.user.uid

            }
          );

        }

      }
    );


    await audit(
      "create_purchase",
      "purchases",
      {
        supplierId,
        total,
        paid,
        balance
      }
    );


    closeModal();

    await loadAll();

    navigate("purchases");


    toast(
      "تم حفظ فاتورة الشراء",
      "success"
    );

  } catch (error) {

    console.error(error);

    toast(
      error.message ||
      "تعذر حفظ فاتورة الشراء",
      "error"
    );

  } finally {

    loading(false);

  }
}


