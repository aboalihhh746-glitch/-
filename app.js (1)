/* =========================================================
   الأحداث الديناميكية
   ========================================================= */

function handleDynamicClick(
  event
) {

  const target =
    event.target.closest(
      "[data-action]"
    );


  if (!target) {
    return;
  }


  const action =
    target.dataset.action;


  if (
    action ===
    "close-modal"
  ) {

    closeModal();

    return;
  }


  if (
    action ===
    "add-cart"
  ) {

    addToCart(
      target.dataset.id
    );

    return;
  }


  if (
    action ===
    "cart-plus"
  ) {

    changeCartQty(
      num(target.dataset.index),
      1
    );

    return;
  }


  if (
    action ===
    "cart-minus"
  ) {

    changeCartQty(
      num(target.dataset.index),
      -1
    );

    return;
  }


  if (
    action ===
    "cart-remove"
  ) {

    const index =
      num(
        target.dataset.index
      );


    state.cart.splice(
      index,
      1
    );


    renderCart();

    calculateCart();

    return;
  }


  if (
    action ===
    "edit-medicine"
  ) {

    const medicine =
      state.medicines.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (medicine) {
      openMedicineModal(
        medicine
      );
    }

    return;
  }


  if (
    action ===
    "delete-medicine"
  ) {

    deleteMedicine(
      target.dataset.id
    );

    return;
  }


  if (
    action ===
    "adjust-stock"
  ) {

    const medicine =
      state.medicines.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (medicine) {

      openStockAdjustment(
        medicine
      );

    }

    return;
  }


  if (
    action ===
    "edit-customer"
  ) {

    const customer =
      state.customers.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (customer) {

      openCustomerModal(
        customer
      );

    }

    return;
  }


  if (
    action ===
    "delete-customer"
  ) {

    deleteCustomer(
      target.dataset.id
    );

    return;
  }


  if (
    action ===
    "customer-payment"
  ) {

    const customer =
      state.customers.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (customer) {

      openCustomerPayment(
        customer
      );

    }

    return;
  }


  if (
    action ===
    "edit-supplier"
  ) {

    const supplier =
      state.suppliers.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (supplier) {

      openSupplierModal(
        supplier
      );

    }

    return;
  }


  if (
    action ===
    "delete-supplier"
  ) {

    deleteSupplier(
      target.dataset.id
    );

    return;
  }


  if (
    action ===
    "supplier-payment"
  ) {

    const supplier =
      state.suppliers.find(
        item =>
          item.id ===
          target.dataset.id
      );


    if (supplier) {

      openSupplierPayment(
        supplier
      );

    }

    return;
  }


  if (
    action ===
    "add-purchase-line"
  ) {

    const lines =
      $("purchaseLines");

    if (!lines) {
      return;
    }


    lines.insertAdjacentHTML(
      "beforeend",
      purchaseLineTemplate()
    );


    updatePurchasePreview();

    return;
  }


  if (
    action ===
    "remove-purchase-line"
  ) {

    const line =
      target.closest(
        ".line-item"
      );


    const container =
      $("purchaseLines");


    if (
      line &&
      container &&
      container.children.length > 1
    ) {

      line.remove();

      updatePurchasePreview();

    }

    return;
  }

}


