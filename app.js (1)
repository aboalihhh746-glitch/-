function addToCart(
  medicineId
) {

  if (!requireCashier()) {
    return;
  }

  const medicine =
    state.medicines.find(
      item =>
        item.id === medicineId
    );


  if (!medicine) {
    return;
  }


  const max =
    num(medicine.quantity);


  if (max <= 0) {

    toast(
      "الدواء غير متوفر",
      "error"
    );

    return;
  }


  const existing =
    state.cart.find(
      item =>
        item.medicineId === medicineId
    );


  if (existing) {

    if (
      existing.qty >=
      max
    ) {

      toast(
        "لا توجد كمية إضافية",
        "warning"
      );

      return;
    }

    existing.qty++;

  } else {

    state.cart.push({

      medicineId,

      name:
        medicine.tradeName,

      salePrice:
        num(medicine.salePrice),

      purchasePrice:
        num(medicine.purchasePrice),

      qty: 1,

      max,

      batchNo:
        medicine.batchNo || "",

      expiryDate:
        medicine.expiryDate || ""

    });

  }


  renderCart();

  calculateCart();
}


function renderCart() {

  const el =
    $("cart");

  if (!el) {
    return;
  }


  const count =
    state.cart.reduce(
      (sum, item) =>
        sum + num(item.qty),
