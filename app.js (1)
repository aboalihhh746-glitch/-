}


function changeCartQty(
  index,
  delta
) {

  const item =
    state.cart[index];

  if (!item) {
    return;
  }


  const newQty =
    num(item.qty) +
    delta;


  if (newQty <= 0) {

    state.cart.splice(
      index,
      1
    );

  } else if (
    newQty <=
    num(item.max)
  ) {

    item.qty =
      newQty;

  } else {

    toast(
      "تجاوزت الكمية المتوفرة",
      "warning"
    );

  }


  renderCart();

  calculateCart();
}


function calculateCart() {

  const subtotal =
    state.cart.reduce(
      (sum, item) =>
        sum +
        num(item.salePrice) *
        num(item.qty),
      0
    );


  const discount =
    Math.max(
      0,
      num(
        $("discount")?.value
      )
    );


  const total =
    Math.max(
      0,
      subtotal - discount
    );


  if ($("cartTotal")) {
    $("cartTotal").textContent =
      money(subtotal);
  }

  if ($("cartNet")) {
    $("cartNet").textContent =
      money(total);
  }

  return {
    subtotal,
    discount,
    total
  };
}


function renderCustomerSelect() {

  const select =
    $("saleCustomer");

  if (!select) {
    return;
  }


  const current =
    select.value;


  select.innerHTML =
    `<option value="">
      عميل نقدي
    </option>`;


  state.customers
    .filter(
      customer =>
        num(customer.balance) >= 0
    )
    .forEach(
      customer => {

        const option =
          document.createElement(
            "option"
          );

        option.value =
          customer.id;

        option.textContent =
          `${customer.name} — رصيد: ${money(
            customer.balance
          )}`;

        select.appendChild(
          option
        );

      }
    );


  if (
    current &&
    state.customers.some(
      customer =>
        customer.id === current
    )
  ) {

    select.value =
      current;
  }
}


