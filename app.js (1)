async function saveMedicine(
  form,
  medicine
) {

  if (!requireStore()) {
    return;
  }


  const fd =
    new FormData(form);


  const data = {

    tradeName:
      String(
        fd.get("tradeName") || ""
      ).trim(),

    scientificName:
      String(
        fd.get("scientificName") || ""
      ).trim(),

    dosageForm:
      String(
        fd.get("dosageForm") || ""
      ).trim(),

    manufacturer:
      String(
        fd.get("manufacturer") || ""
      ).trim(),

    barcode:
      String(
        fd.get("barcode") || ""
      ).trim(),

    batchNo:
      String(
        fd.get("batchNo") || ""
      ).trim(),

    expiryDate:
      String(
        fd.get("expiryDate") || ""
      ),

    quantity:
      Math.max(
        0,
        num(fd.get("quantity"))
      ),

    purchasePrice:
      Math.max(
        0,
        num(fd.get("purchasePrice"))
      ),

    salePrice:
      Math.max(
        0,
        num(fd.get("salePrice"))
      ),

    searchName:
      String(
        fd.get("tradeName") || ""
      ).trim().toLowerCase(),

    updatedAt:
      serverTimestamp()

  };


  if (!data.tradeName) {

    toast(
      "اسم الدواء مطلوب",
      "warning"
    );

    return;
  }


  try {

    let id;


    if (medicine) {

      await updateDoc(
        doc(
          db,
          "medicines",
          medicine.id
        ),
        data
      );

      id =
        medicine.id;

    } else {

      data.createdAt =
        serverTimestamp();

      const ref =
        await addDoc(
          collection(
            db,
            "medicines"
          ),
          data
        );

      id =
        ref.id;

    }


    await audit(
      medicine
        ? "update_medicine"
        : "create_medicine",
      "medicines",
      {
        medicineId: id,
        name: data.tradeName
      }
    );


    closeModal();

    await loadAll();

    navigate("inventory");


    toast(
      medicine
        ? "تم تحديث الدواء"
        : "تم إضافة الدواء",
      "success"
    );

  } catch (error) {

    console.error(error);

