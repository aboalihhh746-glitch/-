   ========================================================= */

function renderDashboard() {

  const medicines =
    state.medicines;

  const low =
    medicines.filter(
      medicine =>
        num(medicine.quantity) <=
        num(state.settings.lowStock)
    );

  const expired =
    medicines.filter(
      medicine =>
        daysUntil(
          medicine.expiryDate
        ) < 0
    );

  const expiring =
    medicines.filter(
      medicine => {

        const days =
          daysUntil(
            medicine.expiryDate
          );

        return (
          days >= 0 &&
          days <=
          num(
            state.settings.expiryDays
          )
        );

      }
    );


  const debts =
    state.customers.reduce(
      (sum, customer) =>
        sum +
        Math.max(
          0,
          num(customer.balance)
        ),
      0
    );


  if ($("statMedicines")) {
    $("statMedicines").textContent =
      medicines.length;
  }

  if ($("statSales")) {
    $("statSales").textContent =
      money(todaySalesTotal());
  }

  if ($("statDebts")) {
    $("statDebts").textContent =
      money(debts);
  }

  if ($("statLow")) {
    $("statLow").textContent =
      low.length;
  }

  if ($("statExpired")) {
    $("statExpired").textContent =
      expired.length;
  }

  if ($("statExpiring")) {
    $("statExpiring").textContent =
      expiring.length;
  }


  renderRecentSales();

  renderAlerts();
}


function renderRecentSales() {

  const el =
    $("recentSales");

  if (!el) {
    return;
  }

  const sales =
    [...state.sales]
      .sort(
        (a, b) =>
          (dateFrom(b.createdAt)?.getTime() || 0) -
          (dateFrom(a.createdAt)?.getTime() || 0)
      )
      .slice(0, 8);


  if (!sales.length) {

    el.innerHTML =
      `<div class="empty-state">
        لا توجد مبيعات حتى الآن
      </div>`;

    return;
  }


  el.innerHTML =
    sales.map(
      sale => `

        <div class="best-selling-item">

          <div>
            <strong>
              فاتورة ${esc(
                sale.invoiceNo || sale.id.slice(-6)
              )}
            </strong>

            <div class="hint">
              ${formatDateTime(sale.createdAt)}
            </div>
          </div>

          <strong>
            ${money(sale.total)}
          </strong>

        </div>

      `
    ).join("");
}


function renderAlerts() {

  const el =
    $("alerts");

  if (!el) {
    return;
  }

  const alerts = [];


  state.medicines.forEach(
    medicine => {

      const quantity =
        num(medicine.quantity);

      if (
        quantity <=
        num(state.settings.lowStock)
      ) {

        alerts.push({

          type: "low",

          title:
            `مخزون منخفض: ${medicine.tradeName}`,

          description:
            `الكمية الحالية: ${quantity}`

        });

      }


      const days =
        daysUntil(
          medicine.expiryDate
        );


      if (days < 0) {

        alerts.push({

          type: "expired",

          title:
            `منتهي الصلاحية: ${medicine.tradeName}`,

          description:
            `تاريخ الانتهاء: ${formatDate(
              medicine.expiryDate
            )}`

        });

      } else if (
        days <=
        num(state.settings.expiryDays)
      ) {

        alerts.push({

          type: "expiry",

          title:
            `قريب الانتهاء: ${medicine.tradeName}`,

          description:
            `متبقي ${days} يوم`

        });

      }

    }
  );


  if (!alerts.length) {

    el.innerHTML =
      `<div class="empty-state">
        لا توجد تنبيهات
      </div>`;

    return;
  }


  el.innerHTML =
    alerts
      .slice(0, 15)
      .map(
        alert => `

          <div class="alert-item">

            <div class="
              alert-icon
              ${alert.type === "expired" ? "danger" : ""}
            ">
              ${alert.type === "low" ? "⚠️" : "⏳"}
            </div>

            <div class="alert-content">

              <div class="alert-title">
                ${esc(alert.title)}
              </div>

              <div class="alert-description">
                ${esc(alert.description)}
              </div>

            </div>

          </div>

        `
      )
      .join("");
}


/* =========================================================
   Inventory
   ========================================================= */

function medicineStatus(
  medicine
) {

  const quantity =
    num(medicine.quantity);

  const days =
    daysUntil(
      medicine.expiryDate
    );


  if (days < 0) {

    return {
      text: "منتهي",
      className: "badge-danger"
    };

  }


  if (
    days <=
    num(state.settings.expiryDays)
  ) {

    return {
      text: "قريب الانتهاء",
      className: "badge-warning"
    };

  }


  if (
    quantity <=
    num(state.settings.lowStock)
  ) {

    return {
      text: "مخزون منخفض",
      className: "badge-warning"
    };

  }


  return {
    text: "جيد",
    className: "badge-success"
  };
}


function renderInventory() {

  const body =
    $("inventoryBody");

  if (!body) {
    return;
  }

  const search =
    String(
      $("inventorySearch")?.value || ""
    )
      .trim()
      .toLowerCase();

  const filter =
    $("inventoryFilter")?.value ||
    "all";


  let items =
    state.medicines.filter(
      medicine => {

        const text =
          [
            medicine.tradeName,
            medicine.scientificName,
            medicine.barcode,
            medicine.batchNo
          ]
            .join(" ")
            .toLowerCase();

        return text.includes(search);
      }
    );


  items =
    items.filter(
      medicine => {

        const status =
          medicineStatus(
            medicine
          );

        if (filter === "low") {

          return (
            num(medicine.quantity) <=
            num(state.settings.lowStock)
          );

        }

        if (filter === "expired") {

          return (
            daysUntil(
              medicine.expiryDate
            ) < 0
          );

        }

        if (filter === "expiring") {

          const days =
            daysUntil(
