function renderReports() {

  const today =
    localToday();


  if (
    $("reportFrom") &&
    !$("reportFrom").value
  ) {

    $("reportFrom").value =
      today;

  }


  if (
    $("reportTo") &&
    !$("reportTo").value
  ) {

    $("reportTo").value =
      today;

  }


  runReport();

  renderBestSelling();
}


function getReportSales() {

  const from =
    $("reportFrom")?.value || "";

  const to =
    $("reportTo")?.value || "";


  return state.sales.filter(
    sale => {

      const date =
        String(
          sale.saleDate || ""
        );


      if (
        from &&
        date < from
      ) {
        return false;
      }


      if (
        to &&
        date > to
      ) {
        return false;
      }


      return true;
    }
  );
}


function runReport() {

  const sales =
    getReportSales();


  const salesTotal =
    sales.reduce(
      (sum, sale) =>
        sum +
        num(sale.total),
      0
    );


  const cogs =
    sales.reduce(
      (sum, sale) =>
        sum +
        num(sale.cogs),
      0
    );


  const gross =
    sales.reduce(
      (sum, sale) =>
        sum +
        num(sale.profit),
      0
    );


  const from =
    $("reportFrom")?.value || "";

  const to =
    $("reportTo")?.value || "";


  const expenses =
    state.treasury

      .filter(
        item =>
          item.type ===
          "expense"
      )

      .filter(
        item => {

          const date =
            dateOnly(
              item.createdAt
            );

          if (
            from &&
            date < from
          ) {
            return false;
          }

          if (
            to &&
            date > to
          ) {
            return false;
          }

          return true;
        }
      )

      .reduce(
        (sum, item) =>
          sum +
          num(item.amount),
        0
      );


  const net =
    gross -
    expenses;


  if ($("reportSales")) {
    $("reportSales").textContent =
      money(salesTotal);
  }

  if ($("reportCOGS")) {
    $("reportCOGS").textContent =
      money(cogs);
  }

  if ($("reportGross")) {
    $("reportGross").textContent =
      money(gross);
  }

  if ($("reportExpenses")) {
    $("reportExpenses").textContent =
      money(expenses);
  }

  if ($("reportNet")) {
    $("reportNet").textContent =
      money(net);
  }


  renderBestSelling(
    sales
  );
}


function renderBestSelling(
  sales = getReportSales()
) {

  const el =
    $("bestSelling");

  if (!el) {
    return;
  }


  const products = {};


  sales.forEach(
    sale => {

      (sale.items || [])
        .forEach(
          item => {

            const key =
              item.medicineId ||
              item.name;


            if (!products[key]) {

              products[key] = {

                name:
                  item.name,

                quantity: 0,

                total: 0

              };

            }


            products[key].quantity +=
              num(item.qty);


            products[key].total +=
              num(item.qty) *
              num(item.price);

          }
        );

    }
  );


  const list =
    Object.values(products)
      .sort(
        (a, b) =>
          b.quantity -
          a.quantity
      )
      .slice(0, 15);


  if (!list.length) {

    el.innerHTML =
      `<div class="empty-state">
        لا توجد بيانات
      </div>`;

    return;
  }


  el.innerHTML =
    list.map(
      (item, index) => `

        <div class="best-selling-item">

          <div>

            <strong>
              ${index + 1}.
              ${esc(item.name)}
            </strong>

            <div class="hint">
              الكمية المباعة:
              ${item.quantity}
            </div>

          </div>

          <strong>
            ${money(item.total)}
          </strong>

        </div>

      `
    ).join("");
}


