async function completeSale() {

  if (!requireCashier()) {
    return;
  }


  if (!state.cart.length) {

    toast(
      "أضف دواء واحدًا على الأقل",
      "warning"
    );

    return;
  }


  const {
    subtotal,
    discount,
    total
  } =
    calculateCart();


  const customerId =
    $("saleCustomer")?.value ||
    "";


  const paymentMethod =
    $("paymentMethod")?.value ||
    "cash";


  if (
    paymentMethod === "credit" &&
    !customerId
  ) {

    toast(
      "يجب اختيار العميل للبيع الآجل",
      "warning"
    );

    return;
  }


  loading(
    true,
    "جاري حفظ الفاتورة..."
  );


  try {

    const saleRef =
      doc(
        collection(
          db,
          "sales"
        )
      );


    const invoiceNo =
      `INV-${Date.now()}`;


    const result =
      await runTransaction(
        db,
        async transaction => {

          let cogs = 0;

          const finalItems = [];


          /*
            إعادة قراءة الأدوية داخل Transaction
            حتى لا نبيع كمية غير موجودة.
          */

          for (
            const cartItem of state.cart
          ) {

            const medicineRef =
              doc(
                db,
                "medicines",
                cartItem.medicineId
              );


            const medicineSnap =
              await transaction.get(
                medicineRef
              );


            if (!medicineSnap.exists()) {

              throw new Error(
                `الدواء غير موجود: ${cartItem.name}`
              );

            }


            const medicine =
              medicineSnap.data();


            const available =
              num(
                medicine.quantity
              );


            if (
              available <
              num(cartItem.qty)
            ) {

              throw new Error(
                `الكمية غير كافية للدواء: ${medicine.tradeName}`
              );

            }


            const quantity =
              available -
              num(cartItem.qty);


            const purchasePrice =
              num(
                medicine.purchasePrice
              );


            cogs +=
              purchasePrice *
              num(cartItem.qty);


            finalItems.push({

              medicineId:
                cartItem.medicineId,

              name:
                medicine.tradeName,

              qty:
                num(cartItem.qty),

              price:
                num(medicine.salePrice),

              cost:
                purchasePrice,

              batchNo:
                medicine.batchNo || "",

              expiryDate:
                medicine.expiryDate || ""

            });


            transaction.update(
              medicineRef,
              {

                quantity,

                updatedAt:
                  serverTimestamp()

              }
            );

          }


          let customerName =
            "";


          if (customerId) {

            const customerRef =
              doc(
                db,
                "customers",
                customerId
              );


            const customerSnap =
              await transaction.get(
                customerRef
              );


            if (!customerSnap.exists()) {

              throw new Error(
                "العميل غير موجود"
              );

            }


            const customer =
              customerSnap.data();


            customerName =
              customer.name ||
              "";


            if (
              paymentMethod ===
              "credit"
            ) {

              transaction.update(
                customerRef,
                {

                  balance:
                    num(customer.balance) +
                    total,

                  updatedAt:
                    serverTimestamp()

                }
              );

            }

          }


          const profit =
            total -
            cogs;


          transaction.set(
            saleRef,
            {

              invoiceNo,

              customerId:
                customerId || "",

              customerName,

              items:
                finalItems,

              subtotal,

              discount,

              total,

              cogs,

              profit,

              paymentMethod,

              saleDate:
                localToday(),

              createdAt:
                serverTimestamp(),

              userId:
                state.user.uid,

              userEmail:
                state.user.email || ""

            }
          );


          if (
            paymentMethod ===
            "cash"
          ) {

            const treasuryRef =
              doc(
                collection(
                  db,
                  "treasury"
                )
              );


            transaction.set(
              treasuryRef,
              {

                type: "income",

                category:
                  "sale",

                description:
                  `بيع نقدي - ${invoiceNo}`,

                amount:
                  total,

                referenceId:
                  saleRef.id,

                createdAt:
                  serverTimestamp(),

                userId:
                  state.user.uid

              }
            );

          }


          return {

            invoiceNo,

            total,

            profit,

            items:
              finalItems

          };

        }
      );


    await audit(
      "create_sale",
      "sales",
      {
        saleId:
          saleRef.id,

        invoiceNo:
          result.invoiceNo,

        total:
          result.total
      }
    );


    state.cart = [];


    if ($("discount")) {
      $("discount").value = "0";
    }


    await loadAll();

    renderPOS();


    toast(
      `تمت عملية البيع — ${result.invoiceNo}`,
      "success"
    );


    printInvoice({

      ...result,

      saleId:
        saleRef.id,

      customerName:
        result.customerName ||
        ""

    });


  } catch (error) {

    console.error(error);

    toast(
      error.message ||
      "تعذر إتمام البيع",
      "error"
    );

  } finally {

    loading(false);

  }
}


