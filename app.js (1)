/* =========================================================
   تحميل Collection
   ========================================================= */

async function loadCollection(
  name,
  sortField = "createdAt"
) {

  try {

    const snap =
      await getDocs(
        collection(db, name)
      );

    const items =
      snap.docs.map(
        item => ({
          id: item.id,
          ...item.data()
        })
      );

    items.sort(
      (a, b) => {

        const av =
          dateFrom(a[sortField])
            ?.getTime() ??
          String(a[sortField] ?? "");

        const bv =
          dateFrom(b[sortField])
            ?.getTime() ??
          String(b[sortField] ?? "");

        if (
          typeof av === "number" &&
          typeof bv === "number"
        ) {
          return bv - av;
        }

        return String(bv)
          .localeCompare(
            String(av),
            "ar"
          );
      }
    );

    return items;

  } catch (error) {

    console.error(
      `Error loading ${name}`,
      error
    );

    return [];
  }
}


