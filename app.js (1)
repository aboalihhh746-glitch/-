/* =========================================================
   Modal
   ========================================================= */

let modalType = "";


function openModal(
  title,
  html,
  type = ""
) {

  modalType =
    type;


  if ($("modalTitle")) {
    $("modalTitle").textContent =
      title;
  }


  if ($("modalBody")) {
    $("modalBody").innerHTML =
      html;
  }


  const modal =
    $("modal");


  if (modal) {

    modal.classList.add(
      "show"
    );

    modal.setAttribute(
      "aria-hidden",
      "false"
    );

  }
}


function closeModal() {

  const modal =
    $("modal");


  if (!modal) {
    return;
  }


  modal.classList.remove(
    "show"
  );


  modal.setAttribute(
    "aria-hidden",
    "true"
  );


  if ($("modalBody")) {
    $("modalBody").innerHTML =
      "";
  }


  modalType = "";
}


